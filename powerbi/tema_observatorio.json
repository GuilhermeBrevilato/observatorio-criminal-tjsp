{
  "name": "Observatório Criminal",
  "dataColors": ["#0F6B45", "#23395B", "#C98A1B", "#9AA5A0", "#5B8C74", "#7A8FB0", "#E0B864", "#C4CCC8"],
  "background": "#FFFFFF",
  "foreground": "#1E2A25",
  "tableAccent": "#0F6B45",
  "good": "#0F6B45",
  "neutral": "#C98A1B",
  "bad": "#23395B",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#0B4A31" },
    "title":   { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#5F6B66" },
    "header":  { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1E2A25" },
    "label":   { "fontSize": 10, "fontFace": "Segoe UI", "color": "#5F6B66" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6F5" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#D9DFDC" } }, "radius": 6 }],
        "dropShadow": [{ "show": false }]
      }
    }
  }
}
